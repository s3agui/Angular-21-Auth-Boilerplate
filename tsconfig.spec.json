{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "outDir": "./out-tsc/spec",
    "rootDir": "src",
    "types": [
      "jasmine",
      "node" 
    ]
  },
  "files": [
    "src/test.ts",
    "src/polyfills.ts"
